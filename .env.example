# ═══════════════════════════════════════════════════════════
# OMNIVERSO ECOSYSTEM — Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── Database ─────────────────────────────────────────────
DB_USER=omniverso
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_NAME=omniverso
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────────
REDIS_PORT=6379

# ─── Qdrant ───────────────────────────────────────────────
QDRANT_PORT=6333

# ─── Gateway ──────────────────────────────────────────────
GATEWAY_PORT=8080
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
API_KEY_SALT=CHANGE_ME_generate_with_openssl_rand_hex_16
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Services ─────────────────────────────────────────────
ORCHESTRATOR_PORT=8001
MODEL_ROUTER_PORT=8002
WEB_PORT=3000

# ─── AI Model Providers ──────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ─── Model Router Defaults ───────────────────────────────
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.5-flash

# ─── GCP (Production) ────────────────────────────────────
GCP_PROJECT_ID=gen-lang-client-0722648923
GCP_REGION=us-central1
